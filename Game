    """Write the embedded game out to a standalone HTML file."""
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(AUAHA_GAME_HTML)
    print(f"Saved playable game to {output_path}")


if __name__ == "__main__":
    save_game()
