function renderModal() {
  const root = document.getElementById('modal-root');
  if (!currentModal) { root.innerHTML = ''; return; }
  root.innerHTML = `<div class="modal-overlay"><div class="modal-box ${currentModal.tone === 'bad' ? 'modal-bad' : currentModal.tone === 'good' ? 'modal-good' : ''}">${currentModal.html}</div></div>`;
  if (currentModal.tone === 'good') triggerGoodFlash();
}

function triggerGoodFlash() {
  const el = document.getElementById('flash-overlay');
  if (!el) return;
  el.classList.remove('flash-good');
  void el.offsetWidth;
  el.classList.add('flash-good');
}

// ============ MASTER RENDER ============
function render() {
  const app = document.getElementById('app');
  if (gamePhase === 'intro') app.innerHTML = renderIntro();
  else if (gamePhase === 'profession') app.innerHTML = renderProfessionSelect();
  else if (gamePhase === 'business') app.innerHTML = renderBusinessSelect();
  else if (gamePhase === 'setup') app.innerHTML = renderSetup();
  else if (gamePhase === 'board') app.innerHTML = renderBoard();
  else if (gamePhase === 'report') app.innerHTML = renderReport();
}

// ============ FLOW CONTROL ============
function goToProfession() {
  gamePhase = 'profession';
  render();
}

function chooseProfession(id) {
  const profession = PROFESSIONS.find(p => p.id === id);
  state = makeState(profession, null);
  gamePhase = 'business';
  render();
}

function chooseBusiness(id) {
  const business = Object.assign({}, BUSINESSES.find(b => b.id === id));
  state.business = business;
  gamePhase = 'setup';
  render();
}

function resolveCapital(choice) {
  setupCapital(state, choice);
  gamePhase = 'board';
  render();
}

function nextMonth() {
  if (state.month >= 12) return;
  state.month++;
  const event = pickEvent(state);
  computeMonth(state, event);

  modalQueue = [];
  modalQueue.push({ type: 'event', data: event });

  if (state.month === STAFFING_MONTH && !state.staffingDecided) {
    modalQueue.push({ type: 'staffing' });
  }
  if (state.month % 3 === 0) {
    modalQueue.push({ type: 'compliance', data: doComplianceCheck(state) });
  }
  if (state.month === 12) {
    modalQueue.push({ type: 'terminal', data: doTerminalTax(state) });
    modalQueue.push({ type: 'growth' });
  }

  render();
  showNextInQueue();
}

function showNextInQueue() {
  if (modalQueue.length === 0) {
    currentModal = null;
    renderModal();
    return;
  }
  const next = modalQueue.shift();
  if (next.type === 'event') currentModal = { tone: next.data.tone, html: eventModalHtml(next.data) };
  else if (next.type === 'staffing') currentModal = { tone: null, html: staffingModalHtml() };
  else if (next.type === 'compliance') currentModal = { tone: next.data.overThreshold ? 'bad' : null, html: complianceModalHtml(next.data) };
  else if (next.type === 'terminal') currentModal = { tone: next.data.diff > 0 ? 'bad' : 'good', html: terminalModalHtml(next.data) };
  else if (next.type === 'growth') currentModal = { tone: null, html: growthForkModalHtml() };
  renderModal();
}

function advanceModal() {
  showNextInQueue();
}

function resolveStaffing(hire) {
  state.hasStaff = hire;
  state.staffingDecided = true;
  showNextInQueue();
}

function resolveGrowth(choice) {
  state.growthChoice = choice;
  currentModal = null;
  renderModal();
  gamePhase = 'report';
  render();
}

function restartGame() {
  state = null;
  gamePhase = 'intro';
  currentModal = null;
  modalQueue = [];
  render();
  renderModal();
}

// ============ INIT ============
render();
</script>
</body>
</html>
"""


