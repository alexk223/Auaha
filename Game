  </g>
</svg>`;
const STAFFING_MONTH = 5;
const TAX_THRESHOLD = 5000;
const TAX_RATE = 0.28;
const KINGS_TRUST_CAP = 5000;
const GST_THRESHOLD = 60000;

// ============ FORMATTERS ============
function fmtWhole(n) {
  const sign = n < 0 ? '\u2212' : '';
  return sign + '$' + Math.abs(Math.round(n)).toLocaleString('en-NZ');
}
function fmtUnit(n) {
  return '$' + n.toFixed(2);
}

// ============ CORE LOGIC (tested standalone before wiring to the UI) ============
function pickEvent(state) {
  const pool = EVENTS.filter(e => {
    if (e.onlyFor && !e.onlyFor.includes(state.business.id)) return false;
    if (e.onlyIfCashBelow !== undefined && state.cash >= e.onlyIfCashBelow) return false;
    return true;
  });
  return pool[Math.floor(Math.random() * pool.length)];
}

function makeState(profession, business) {
  return {
    profession, business,
    cash: 0,
    month: 0,
    demandMult: 1, demandMonthsLeft: 0,
    costMult: 1, costMonthsLeft: 0,
    hasStaff: false, staffingDecided: false,
    yearProfitRunning: 0,
    taxPaidRunning: 0,
    agenciesUsed: new Set(),
    history: [],
    startingShortfall: 0,
    growthChoice: null,
    terminalResult: null,
    swot: { strength: '', weakness: '', opportunity: '', threat: '' }
  };
}

function updateSwot(field, value) {
  state.swot[field] = value;
  const echo = document.getElementById('swot-echo-' + field);
  if (echo) echo.textContent = value;
}

function computeBreakEvenMonth(history) {
  let cumulative = 0;
  for (const h of history) {
    cumulative += h.net;
    if (cumulative >= 0) return h.month;
  }
  return null;
}

function setupCapital(state, choice) {
  const gap = state.business.setupCost - state.profession.startCash;
  if (gap <= 0) {
    state.cash = state.profession.startCash - state.business.setupCost;
    return;
  }
  if (choice === 'bootstrap') {
    state.cash = 0;
    state.business.baseUnitsPerMonth = Math.round(state.business.baseUnitsPerMonth * 0.75);
  } else if (choice === 'kingstrust') {
    const grant = Math.min(gap, KINGS_TRUST_CAP);
    state.agenciesUsed.add("King's Trust (Kia Tupu)");
    let resultCash = state.profession.startCash - state.business.setupCost + grant;
    if (resultCash < 0) {
      state.startingShortfall = Math.abs(resultCash);
      resultCash = 0;
    }
    state.cash = resultCash;
  }
}

function computeMonth(state, event) {
  if (event.demandMult) { state.demandMult = event.demandMult; state.demandMonthsLeft = event.demandMonths; }
  if (event.costMult) { state.costMult = event.costMult; state.costMonthsLeft = event.costMonths; }

  const variance = 0.85 + Math.random() * 0.3;
  const units = Math.max(0, Math.round(state.business.baseUnitsPerMonth * state.demandMult * variance));
  const costPerUnitNow = state.business.costPerUnit * state.costMult;
  const revenue = Math.round(units * state.business.pricePerUnit);
  const cogs = Math.round(units * costPerUnitNow);
  const staffCost = state.hasStaff ? STAFF_MONTHLY_COST : 0;
  const oneOff = event.oneOffCost || 0;
  const cashDelta = event.cashDelta || 0;

  if (event.agency) state.agenciesUsed.add(event.agency);

  const net = revenue - cogs - staffCost - oneOff + cashDelta;
  state.cash = state.cash + net;
  state.yearProfitRunning = state.yearProfitRunning + net;

  state.history.push({
    month: state.month, units, revenue, cogs, staffCost, oneOff, cashDelta, net,
    cashAfter: state.cash, eventTitle: event.title, eventTone: event.tone
  });

  if (state.demandMonthsLeft > 0) { state.demandMonthsLeft--; if (state.demandMonthsLeft === 0) state.demandMult = 1; }
  else { state.demandMult = 1; }
  if (state.costMonthsLeft > 0) { state.costMonthsLeft--; if (state.costMonthsLeft === 0) state.costMult = 1; }
  else { state.costMult = 1; }
}

function doComplianceCheck(state) {
  if (state.yearProfitRunning > TAX_THRESHOLD) {
    const estimatedTotal = Math.round(state.yearProfitRunning * TAX_RATE);
    const instalment = Math.max(0, estimatedTotal - state.taxPaidRunning);
    state.cash -= instalment;
    state.taxPaidRunning += instalment;
    return { overThreshold: true, instalment, runningProfit: state.yearProfitRunning };
  }
  return { overThreshold: false, runningProfit: state.yearProfitRunning, instalment: 0 };
}

function doTerminalTax(state) {
  if (state.terminalResult) return state.terminalResult;
  const finalTaxOwed = state.yearProfitRunning > TAX_THRESHOLD ? Math.round(state.yearProfitRunning * TAX_RATE) : 0;
  const diff = finalTaxOwed - state.taxPaidRunning;
  state.cash -= diff;
  state.terminalResult = { finalTaxOwed, paidSoFar: state.taxPaidRunning, diff };
  return state.terminalResult;
}

